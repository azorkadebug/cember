rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin tüm profilleri okuyabilir
      allow read: if request.auth != null && request.auth.uid == 'A1Xyb80fR7NQ6KuwBt6NUa5p2743';
    }

    match /siniflar/{sinifId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      match /ogrenciler/{ogrenciId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/siniflar/$(sinifId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
